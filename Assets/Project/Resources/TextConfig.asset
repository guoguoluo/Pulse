    chinese: "\u6559\u5B66\u624B\u518C"
    english: 
  - key: ui.pausemenu.resume
    chinese: "\u8FD4\u56DE\u6E38\u620F"
    english: 
  - key: ui.pausemenu.mainmenu
    chinese: "\u56DE\u5230\u4E3B\u83DC\u5355"
    english: 
  - key: ui.manual.title
    chinese: "\u73A9\u6CD5\u6559\u5B66"
    english: 
  - key: ui.manual.body
    chinese: "WASD / \u65B9\u5411\u952E\uFF1A\u79FB\u52A8\n\u79FB\u52A8\u9F20\u6807\uFF1A\u6307\u6325\uFF1B\u5411\u4E0B\u6325\u52A8\uFF0C\u4E0E\u6BCF\u5C0F\u8282\u7B2C\u4E00\u62CD\u7684\u5F15\u5BFC\u6D41\u661F\u540C\u6B65\n\u4EFB\u610F\u52A8\u4F5C\u90FD\u4F1A\u77ED\u6682\u7167\u4EAE\u5468\u56F4\uFF1B\u51C6\u786E\u547D\u4E2D\u4F1A\u7559\u4E0B\u6301\u4E45\u5149\u8DEF\n\u63A2\u7D22\u5730\u56FE\uFF0C\u9760\u8FD1\u6B8B\u7AE0\u6309
      F \u62FE\u53D6\uFF1B\u6309 J \u9605\u8BFB\u65E5\u8BB0"
    english: 
  - key: ui.manual.back
    chinese: "\u8FD4\u56DE"
    english: 
  - key: hud.initial.default
    chinese: WASD Move | Mouse Look | F Pick | RMB Resonate
    english: 
  - key: hud.noInstrument.default
    chinese: Move closer to the object.
    english: 
  - key: hud.withInstrument.default
    chinese: Right click 3 times to resonate.
    english: 
