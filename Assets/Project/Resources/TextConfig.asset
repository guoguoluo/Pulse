  rows:
  - key: journal.01.title
    chinese: "01 \xB7 \u9009\u62E9 / \u5DE5\u4F5C\u65E5\u5FD7"
    english: "01 \xB7 Selection / Work Log"
  - key: journal.01.body
    chinese: "\u5728\u79BB\u5F00\u4E4B\u524D\uFF0C\u6211\u4EEC\u5F00\u8FC7\u5F88\u591A\u6B21\u4F1A\u3002\n\n\u6709\u4EBA\u63D0\u8BAE\u7559\u4E0B\u57CE\u5E02\u7684\u56FE\u7EB8\uFF0C\u6709\u4EBA\u8BF4\u5E94\u8BE5\u7559\u4E0B\u57FA\u56E0\u3001\u5F8B\u6CD5\uFF0C\u6216\u8005\u6211\u4EEC\u66FE\u7ECF\u770B\u89C1\u7684\u5929\u7A7A\u3002\u53EF\u662F\u8FD9\u9897\u661F\u7403\u5E76\u4E0D\u8BC6\u5B57\uFF0C\u4E5F\u4E0D\u4F1A\u66FF\u6211\u4EEC\u8FA8\u8BA4\u4E00\u5EA7\u5E9F\u589F\u3002\n\n\u6211\u5728\u540D\u5355\u4E0A\u5199\u4E0B\uFF1A\u97F3\u4E50\u3002\u6CA1\u6709\u4EBA\u7ACB\u523B\u8D5E\u6210\uFF0C\u4E5F\u6CA1\u6709\u4EBA\u5212\u6389\u5B83\u3002"
    english: 
  - key: journal.02.title
    chinese: "02 \xB7 \u5BB9\u5668 / \u5DE5\u4F5C\u65E5\u5FD7"
    english: "02 \xB7 Vessel / Work Log"
  - key: journal.02.body
    chinese: "\u4E5D\u79CD\u827A\u672F\u88AB\u91CD\u65B0\u6446\u5728\u684C\u4E0A\u3002\u6211\u4EEC\u4E0D\u662F\u8981\u8BC4\u51FA\u80DC\u8D1F\uFF0C\u800C\u662F\u5728\u95EE\uFF1A\u5F53\u6CA1\u6709\u4EBA\u80FD\u591F\u89E3\u91CA\u4EBA\u7C7B\u65F6\uFF0C\u4EC0\u4E48\u8FD8\u80FD\u88AB\u53E6\u4E00\u4E2A\u4E16\u754C\u611F\u5230\uFF1F\n\n\u5DE5\u7A0B\u7EC4\u628A\u4E00\u4E2A\u6781\u7A84\u7684\u9891\u7387\u7A97\u53E3\u5199\u8FDB\u4E86\u50A8\u5B58\u5668\u3002\u5B83\u4E0D\u628A\u6B4C\u58F0\u9501\u5728\u91D1\u5C5E\u91CC\uFF1B\u5B83\u8BA9\u632F\u52A8\u9644\u7740\u4E8E\u6839\u7CFB\u3001\u6C34\u6D41\u4E0E\u5CA9\u5C42\u3002\u53EA\u8981\u73AF\u5883\u8FD8\u5728\u56DE\u5E94\uFF0C\u97F3\u4E50\u5C31\u6709\u673A\u4F1A\u518D\u6B21\u53D1\u751F\u3002"
    english: 
  - key: journal.03.title
    chinese: "03 \xB7 \u79FB\u690D / \u5DE5\u4F5C\u65E5\u5FD7"
    english: "03 \xB7 Transplant / Work Log"
  - key: journal.03.body
    chinese: "\u7B2C\u4E00\u6279\u8BD5\u9A8C\u5728\u6E29\u5BA4\u91CC\u5B8C\u6210\u3002\u679D\u53F6\u6CA1\u6709\u5B66\u4F1A\u5F39\u7434\u3002\u662F\u6211\u4EEC\u8BA9\u7A7A\u6C14\u4E0E\u7EC4\u7EC7\u5BF9\u540C\u4E00\u4E2A\u8282\u594F\u4EA7\u751F\u5171\u632F\uFF0C\u518D\u7531\u5B83\u4EEC\u53D1\u51FA\u81EA\u5DF1\u7684\u58F0\u97F3\u3002\n\n\u6211\u63E1\u7740\u6307\u6325\u68D2\uFF0C\u5411\u4E0B\u6325\u52A8\u3002\u83CC\u4E1D\u4EAE\u8D77\uFF0C\u6811\u53F6\u6CBF\u7740\u5C0F\u5F84\u56DE\u54CD\u3002\u6211\u4EEC\u6CA1\u6709\u6559\u690D\u7269\u6A21\u4EFF\u4EBA\u7C7B\uFF1B\u6211\u4EEC\u53EA\u662F\u9080\u8BF7\u5B83\u4EEC\u53C2\u4E0E\u3002"
    english: 
  - key: journal.04.title
    chinese: "04 \xB7 \u5355\u7A0B / \u5DE5\u4F5C\u65E5\u5FD7"
    english: "04 \xB7 One Way / Work Log"
  - key: journal.04.body
    chinese: "\u822A\u884C\u8BA1\u5212\u7684\u71C3\u6599\u53EA\u591F\u62B5\u8FBE\uFF0C\u4E0D\u591F\u8FD4\u822A\u3002\u6211\u7684\u540D\u5B57\u88AB\u5199\u5728\u6267\u884C\u8005\u4E00\u680F\uFF0C\u65C1\u8FB9\u6CA1\u6709\u7B2C\u4E8C\u4E2A\u540D\u5B57\u3002\n\n\u6211\u77E5\u9053\u8FD9\u610F\u5473\u7740\u4EC0\u4E48\u3002\u4ECD\u7136\u7B7E\u4E86\u5B57\u3002\u4E0D\u662F\u56E0\u4E3A\u6211\u52C7\u6562\uFF0C\u800C\u662F\u56E0\u4E3A\u6211\u60F3\u5230\uFF1A\u82E5\u6709\u4E00\u5929\u8FD9\u4E9B\u58F0\u97F3\u80FD\u5728\u65E0\u4EBA\u8046\u542C\u65F6\u7EE7\u7EED\uFF0C\u6216\u8BB8\u6211\u4EEC\u7559\u4E0B\u7684\u5C31\u4E0D\u662F\u4E00\u5EA7\u5893\u7891\u3002"
    english: 
  - key: journal.05.title
    chinese: "05 \xB7 \u4F11\u7720 / \u5DE5\u4F5C\u65E5\u5FD7"
    english: "05 \xB7 Hibernation / Work Log"
  - key: journal.05.body
    chinese: "\u50A8\u5B58\u5668\u5DF2\u690D\u5165\u8FD9\u9897\u661F\u7403\u7684\u5FAA\u73AF\u3002\u6700\u540E\u4E00\u6B21\u6821\u51C6\u8BB0\u5F55\uFF1A\u4E0B\u884C\u624B\u52BF\u3001\u7B2C\u4E00\u62CD\u3001\u6839\u7CFB\u54CD\u5E94\u3002\u5404\u9879\u65F6\u95F4\u8BEF\u5DEE\u5747\u5728\u5141\u8BB8\u8303\u56F4\u5185\u3002\n\n\u4EFB\u52A1\u5B8C\u6210\u540E\uFF0C\u6211\u5E94\u5F53\u81EA\u52A8\u8FDB\u5165\u4F11\u7720\uFF0C\u76F4\u81F3\u751F\u547D\u7EC8\u6B62\u3002\u8FD9\u662F\u4E00\u8D9F\u5355\u5411\u65C5\u7A0B\uFF1B\u6211\u6CA1\u6709\u8BBE\u5B9A\u518D\u6B21\u9192\u6765\u7684\u95F9\u949F\u3002\u82E5\u4F11\u7720\u8BBE\u5907\u51FA\u73B0\u6545\u969C\uFF0C\u800C\u6211\u5FD8\u4E86\u4E3A\u4F55\u6765\u5230\u8FD9\u91CC\uFF0C\u8BF7\u5FAA\u7740\u8FD9\u4E9B\u5DE5\u4F5C\u65E5\u5FD7\u786E\u8BA4\uFF1A\u97F3\u4E50\u5DF2\u7ECF\u7559\u5728\u8FD9\u9897\u661F\u7403\u3002"
    english: 'The storage device has been integrated into this planet''s cycles.
      Final calibration: downstroke, first beat, root response. All timing deviations
      are within tolerance.


      Once the mission is complete, I am to enter hibernation
      until my life ends. This was a one-way journey. No wake-up time was set. If
      the hibernation system fails and I forget why I came, these work logs will
      confirm it: the music is here.'
  - key: journal.06.title
    chinese: "06 \xB7 \u56DE\u58F0 / \u5DE5\u4F5C\u65E5\u5FD7"
    english: "06 \xB7 Echo / Work Log"
  - key: journal.06.body
    chinese: "\u4F11\u7720\u7CFB\u7EDF\u6545\u969C\u8BB0\u5F55\uFF1A\u610F\u5916\u5524\u9192\u3002\u8BB0\u5FC6\u6062\u590D\u4E0D\u5B8C\u6574\u3002\u516D\u4EFD\u5DE5\u4F5C\u65E5\u5FD7\u6563\u843D\u5728\u7740\u9646\u533A\u57DF\uFF0C\u5DF2\u9010\u4E00\u627E\u56DE\u3002\n\n\u4F9D\u636E\u822A\u884C\u65F6\u95F4\u4E0E\u5730\u7403\u6700\u540E\u4E00\u6B21\u8BAF\u53F7\u63A8\u7B97\uFF0C\u6211\u5927\u6982\u662F\u6700\u540E\u4E00\u4E2A\u4ECD\u5728\u547C\u5438\u7684\u4EBA\u7C7B\u3002\u6CA1\u6709\u4EBA\u80FD\u66FF\u6211\u786E\u8BA4\u8FD9\u4E2A\u7ED3\u8BBA\uFF0C\u4F46\u6211\u5DF2\u786E\u8BA4\u4EFB\u52A1\u5B8C\u6210\uFF1A\u98CE\u3001\u83CC\u4E1D\u4E0E\u5CA9\u5C42\u90FD\u63A5\u4F4F\u4E86\u90A3\u6BB5\u65CB\u5F8B\u3002\n\n\u6309\u539F\u5B9A\u6D41\u7A0B\uFF0C\u6211\u5C06\u91CD\u65B0\u8FDB\u5165\u4F11\u7720\u3002\u97F3\u4E50\u4E0D\u518D\u9700\u8981\u6211\u5B88\u7740\u3002"
    english: 'Hibernation system fault: unexpected awakening. Memory recovery incomplete.
      Six work logs were scattered near the landing site; all have now been recovered.


      By
      the voyage timeline and Earth''s final transmission, I may be the last living
      human. No one can verify that. But the mission is complete: wind, mycelium,
      and stone now carry the music.


      I will return to hibernation as planned.
      The music no longer needs me to keep watch.'
  - key: journal.acquired
    chinese: "\u83B7\u5F97\u5DE5\u4F5C\u65E5\u5FD7\u6B8B\u7AE0 \xB7 {0}   J \u9605\u8BFB"
    english: "Work log recovered \xB7 {0}   J Read"
  - key: journal.pickup
    chinese: "F  \u62FE\u53D6\u5DE5\u4F5C\u65E5\u5FD7\u6B8B\u7AE0"
    english: F  Pick up work log
  - key: journal.nearby
    chinese: "\u53D1\u73B0\u5DE5\u4F5C\u65E5\u5FD7\u6B8B\u7AE0 \xB7 \u8DDF\u968F\u6D41\u661F\uFF0C\u5728\u7B2C\u4E00\u62CD\u4E0B\u6325"
    english: "Work log nearby \xB7 Follow the meteor and strike on the first beat"
  - key: journal.open
    chinese: "J  \u5DE5\u4F5C\u65E5\u5FD7"
    english: J  Work logs
  - key: journal.controls
    chinese: "\u2190 \u2192 \u7FFB\u9875   J / Esc \u5173\u95ED"
    english: 
  - key: journal.counter
    chinese: '{0:00} / {1:00}'
    english: 
  - key: goal.reached
    chinese: You reached the high place. The pulse accepts you.
    english: You reached the high place. The pulse accepts you.
  - key: world.pickup
    chinese: F
    english: F
  - key: narrative.01
    chinese: The machine breathes. Not air. Memory. Every pulse a word unspoken.
    english: The machine breathes. Not air. Memory. Every pulse a word unspoken.
  - key: narrative.02
    chinese: 
    english: 
  - key: narrative.03
    chinese: Your footsteps are a cipher. The planet decrypts them one by one.
    english: Your footsteps are a cipher. The planet decrypts them one by one.
  - key: narrative.04
    chinese: We were never explorers. We were always the message.
    english: We were never explorers. We were always the message.
  - key: narrative.05
    chinese: At the end of the corridor... the machine speaks in her voice.
    english: At the end of the corridor... the machine speaks in her voice.
  - key: hud.initial
    chinese: try to go high
    english: try to go high
  - key: hud.noInstrument
    chinese: Find the object ahead and press F.
    english: Find the object ahead and press F.
  - key: hud.pickup
    chinese: F
    english: F
  - key: hud.withInstrument
    chinese: Listen to the pulse and repeat the rhythm.
    english: Listen to the pulse and repeat the rhythm.
  - key: hud.success
    chinese: The path rises. Climb upward.
    english: The path rises. Climb upward.
